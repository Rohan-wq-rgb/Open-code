# Local development only. Copy to .env and load it yourself, for example:
#   set -a; source .env; set +a; python server.py
# Never commit the real .env (it is in .gitignore).
APP_PASSWORD=change-me-to-something-long
SESSION_SECRET=replace-with-64-random-characters-from-openssl-rand-hex-32
OPENROUTER_API_KEYS=sk-or-v1-xxxxxxxx,sk-or-v1-yyyyyyyy
